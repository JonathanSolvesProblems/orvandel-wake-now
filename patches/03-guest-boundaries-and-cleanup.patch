+// The hourly guest sweep (shared/guest.ts): guests never kept and not played for a day are deleted, with their heroes,
+// by the same statements as "Delete my account". Anyone online is skipped (app.ts tells this file who is).
+let lastGuestSweep = 0;
+let guestOnline: (accountId: number) => boolean = () => false;
+export function guestsOnlineFrom(fn: (accountId: number) => boolean): void { guestOnline = fn; }
+
+/** Deletes the guests stale at `now` that are not online; returns their account ids. */
+export function sweepGuests(now = Date.now()): number[] {
+  const gone: number[] = [];
+  for (const id of accounts.staleGuests(now - GUEST_STALE_MS)) {
+    if (guestOnline(id)) continue;
+    accountData.delete(id);
+    gone.push(id);
+  }
+  return gone;
+}
+
+/** The minute timer's call: sweeps at most once an hour. Null when it was not due. */
+export function maybeSweepGuests(now = Date.now()): number[] | null {
+  if (now - lastGuestSweep < GUEST_SWEEP_EVERY_MS) return null;
+  lastGuestSweep = now;
+  return sweepGuests(now);
+}
+
