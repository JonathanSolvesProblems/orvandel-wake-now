+
+  /** Logging out ends a guest's session for good (it has no password to sign back in with): ask first, offering to keep the hero. */
+  function confirmGuestLogout() {
+    const m = document.createElement('div');
+    m.className = 'modal-veil';
+    m.innerHTML = `
+      <div class="modal stone" role="dialog" aria-modal="true" aria-labelledby="gl-title">
+        <h2 id="gl-title" class="display">Leave as a guest?</h2>
+        <p>A guest has no password, so logging out ends it for good. ${esc(sel.name)} will be lost unless you keep the hero first.</p>
+        <div class="modal-actions">
+          <button type="button" class="btn-ghost" data-anyway>Log out anyway</button>
+          <button type="button" class="btn-primary" data-keep>Keep this hero</button>
+        </div>
+      </div>`;
+    el.appendChild(m);
+    const close = () => m.remove();
+    m.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
+    m.addEventListener('click', (e) => { if (e.target === m) close(); });
+    m.querySelector('[data-anyway]')!.addEventListener('click', () => { close(); opts.onLogout(); });
+    m.querySelector('[data-keep]')!.addEventListener('click', () => { close(); el.querySelector<HTMLElement>('[data-account]')!.click(); });
+    window.setTimeout(() => m.querySelector<HTMLElement>('[data-keep]')?.focus(), 0);
+  }
   el.querySelector('[data-account]')!.addEventListener('click', (e) => {
