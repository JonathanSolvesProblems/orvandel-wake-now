   const now = Date.now();
   for (const m of [attempts, resetByIp, resetByName, redeemByIp, redeemByAccount, adminByIp]) for (const [k, list] of m) if (!list.some((t) => now - t < 5 * 60 * 1000)) m.delete(k);
   try { sessions.purgeExpired(); } catch { /* the database was closed (a test or a shutdown) */ }
   try { site.purgeOld(); } catch { /* the database was closed or never opened */ }
+  try { maybeSweepGuests(now); } catch { /* the database was closed or never opened */ }
 }, 60_000).unref();
 
