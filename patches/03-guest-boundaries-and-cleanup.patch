+  /** The one calm line a guest meets at a door kept for named accounts, with the way to keep the hero. */
+  function guestDoor() {
+    const m = document.createElement('div');
+    m.className = 'modal-veil';
+    m.innerHTML = `
+      <div class="modal stone" role="dialog" aria-modal="true" aria-labelledby="gd-title">
