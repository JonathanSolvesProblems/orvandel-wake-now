+/**
+ * Keep this hero: the guest names the account. The same rules and messages as sign-up; on success the account has the
+ * name, the password and a recovery code (returned once), the guest mark is gone, and the session and the hero are unchanged.
+ */
+export async function keepGuest(accountId: number, username: unknown, password: unknown): Promise<{ ok: true; account: AccountInfo; recoveryCode: string } | { ok: false; status: number; error: string }> {
+  const acc = accounts.byId(accountId);
+  if (!acc?.guest) return { ok: false, status: 409, error: NOT_A_GUEST };
+  const err = validateCredentials(username, password);
+  if (err) return { ok: false, status: 400, error: err };
+  const u = username as string;
+  if (accounts.byName(u)) return { ok: false, status: 409, error: 'That username is taken.' };
+  const recoveryCode = newRecoveryCode();
+  const r = accounts.keep(accountId, u, await hashPassword(password as string), await hashPassword(normalizeRecoveryCode(recoveryCode)!));
+  if (r === 'taken') return { ok: false, status: 409, error: 'That username is taken.' };
+  if (r === 'gone') return { ok: false, status: 409, error: NOT_A_GUEST };
+  return { ok: true, account: { id: accountId, username: u }, recoveryCode };
+}
