+  // Wake now: its own 16+ box (the button stays disabled until it is ticked), then a guest and its hero, straight in.
+  const wakeGo = el.querySelector<HTMLButtonElement>('[data-wake-go]')!;
+  const wakeBox = el.querySelector<HTMLInputElement>('[data-wake-terms]')!;
+  const wakeErr = el.querySelector<HTMLElement>('[data-wake-error]')!;
+  wakeBox.addEventListener('change', () => { wakeGo.disabled = !wakeBox.checked; wakeErr.textContent = ''; if (wakeBox.checked) opts.onWakeIntent?.(); });
+  wakeGo.addEventListener('click', async () => {
+    if (!wakeBox.checked || wakeGo.classList.contains('busy')) return;
+    wakeErr.textContent = '';
+    wakeGo.classList.add('busy');
+    mark('wake:click');
+    try {
+      const res = await api.guest(true);
+      mark('wake:made');
+      opts.onWake(res.account, res.character);
+    } catch (ex: any) {
+      wakeErr.textContent = ex?.message ?? 'Something went wrong.';
+      wakeGo.classList.remove('busy');
+    }
+  });
+
